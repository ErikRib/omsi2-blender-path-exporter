    {
      "id": "A2",
      "name": "Elementary",
      "name_pt": "Elementar",
      "description": "Everyday situations and simple conversations.",
      "topics": [
        {
          "id": "present_simple",
          "title": "Present Simple",
          "title_pt": "Presente Simples",
          "content": [
            {"english": "I work every day.", "portuguese": "Eu trabalho todos os dias."},
            {"english": "She likes coffee.", "portuguese": "Ela gosta de café."},
            {"english": "They don't eat meat.", "portuguese": "Eles não comem carne."},
            {"english": "Do you speak English?", "portuguese": "Você fala inglês?"},
            {"english": "Does he live here?", "portuguese": "Ele mora aqui?"}
          ],
          "grammar": {
            "topic": "Present Simple Rules",
            "explanation": "Usado para hábitos, rotinas e fatos. Na 3ª pessoa do singular (he/she/it), adiciona-se -s/-es ao verbo.",
            "rules": [
              "I/You/We/They + verbo base: 'I work'",
              "He/She/It + verbo + s/es: 'He works'",
              "Negativa: don't / doesn't + verbo base",
              "Interrogativa: Do / Does + sujeito + verbo base"
            ]
          },
          "quiz": [
            {
              "question": "Choose the correct form: 'He ___ to school every day.'",
              "options": ["go", "goes", "going", "gone"],
              "answer": 1,
              "explanation": "He (3ª pessoa singular) → goes (go + es)."
            },
            {
              "question": "Make it negative: 'She drinks coffee.'",
              "options": ["She not drinks coffee.", "She doesn't drinks coffee.", "She doesn't drink coffee.", "She don't drink coffee."],
              "answer": 2,
              "explanation": "He/She/It usa 'doesn't' + verbo na forma base (sem -s)."
            }
          ]
        },
        {
          "id": "past_simple",
          "title": "Past Simple",
          "title_pt": "Passado Simples",
          "content": [
            {"english": "I worked yesterday.", "portuguese": "Eu trabalhei ontem."},
            {"english": "She went to the store.", "portuguese": "Ela foi à loja."},
            {"english": "We didn't watch TV.", "portuguese": "Nós não assistimos TV."},
            {"english": "Did you call me?", "portuguese": "Você me ligou?"}
          ],
          "grammar": {
            "topic": "Past Simple Rules",
            "explanation": "Usado para ações concluídas no passado. Verbos regulares recebem -ed; irregulares têm formas próprias.",
            "rules": [
              "Verbos regulares: work → worked, call → called",
              "Verbos irregulares: go → went, have → had, see → saw",
              "Negativa: didn't + verbo base",
              "Interrogativa: Did + sujeito + verbo base"
            ]
          },
          "quiz": [
            {
              "question": "What is the past of 'go'?",
              "options": ["goed", "went", "gone", "goes"],
              "answer": 1,
              "explanation": "'Go' é irregular: go → went (passado simples)."
            },
            {
              "question": "'I ___ (eat) pizza last night.'",
              "options": ["eated", "ate", "eat", "eaten"],
              "answer": 1,
              "explanation": "Eat é irregular: eat → ate."
            }
          ]
        }
      ]
    },
    {
      "id": "B1",
      "name": "Intermediate",
      "name_pt": "Intermediário",
      "description": "Clear communication on familiar topics.",
      "topics": [
        {
          "id": "present_perfect",
          "title": "Present Perfect",
          "title_pt": "Presente Perfeito",
          "content": [
            {"english": "I have lived here for 5 years.", "portuguese": "Eu moro aqui há 5 anos."},
            {"english": "She has never been to Europe.", "portuguese": "Ela nunca foi à Europa."},
            {"english": "Have you ever eaten sushi?", "portuguese": "Você já comeu sushi?"},
            {"english": "We have just finished the project.", "portuguese": "Nós acabamos de terminar o projeto."}
          ],
          "grammar": {
            "topic": "Present Perfect: have/has + past participle",
            "explanation": "Usado para experiências de vida, ações que continuam no presente ou ações recentes. Conecta passado e presente.",
            "rules": [
              "Formação: have/has + past participle (3ª coluna)",
              "I/You/We/They have worked",
              "He/She/It has worked",
              "Palavras-chave: ever, never, already, yet, just, for, since"
            ]
          },
          "quiz": [
            {
              "question": "'She ___ (never/see) that movie.'",
              "options": ["has never saw", "have never seen", "has never seen", "never has seen"],
              "answer": 2,
              "explanation": "She = has; see → seen (particípio); 'never' fica entre has e seen."
            },
            {
              "question": "When do we use 'for' vs 'since'?",
              "options": [
                "Both mean the same thing.",
                "'For' = período de tempo; 'since' = ponto de início.",
                "'For' = ponto de início; 'since' = período de tempo.",
                "'Since' is used with future."
              ],
              "answer": 1,
              "explanation": "'For 3 years' (período); 'since 2020' (ponto de início)."
            }
          ]
        }
      ]
    },
    {
      "id": "B2",
      "name": "Upper-Intermediate",
      "name_pt": "Intermediário Superior",
      "description": "Fluent discussions on complex topics.",
      "topics": [
        {
          "id": "conditionals",
          "title": "Conditionals",
          "title_pt": "Condicionais (Se...)",
          "content": [
            {"english": "If it rains, I'll stay home. (1st conditional)", "portuguese": "Se chover, ficarei em casa. (real/provável)"},
            {"english": "If I had money, I would travel. (2nd conditional)", "portuguese": "Se eu tivesse dinheiro, viajaria. (hipotético/improvável)"},
            {"english": "If I had studied, I would have passed. (3rd conditional)", "portuguese": "Se eu tivesse estudado, teria passado. (impossível/passado)"}
          ],
          "grammar": {
            "topic": "Types of Conditionals",
            "explanation": "Condicionais expressam situações hipotéticas ou seus resultados.",
            "rules": [
              "Zero: If + present → present (fatos gerais)",
              "1st: If + present → will + base (futuro real)",
              "2nd: If + past → would + base (hipotético)",
              "3rd: If + past perfect → would have + participle (arrependimento/impossível)"
            ]
          },
          "quiz": [
            {
              "question": "Choose the correct conditional: 'If I ___ (be) rich, I ___ (buy) a yacht.'",
              "options": ["am / will buy", "were / would buy", "was / would have bought", "am / would buy"],
              "answer": 1,
              "explanation": "2nd conditional (hipotético): If + were + would + base verb."
            }
          ]
        }
      ]
    },
    {
      "id": "C1",
      "name": "Advanced",
      "name_pt": "Avançado",
      "description": "Sophisticated language for professional and academic contexts.",
      "topics": [
        {
          "id": "passive_voice",
          "title": "Passive Voice",
          "title_pt": "Voz Passiva",
          "content": [
            {"english": "The book was written by Machado de Assis.", "portuguese": "O livro foi escrito por Machado de Assis."},
            {"english": "The project is being reviewed.", "portuguese": "O projeto está sendo revisado."},
            {"english": "The report will be submitted tomorrow.", "portuguese": "O relatório será entregue amanhã."}
          ],
          "grammar": {
            "topic": "Passive Voice Formation",
            "explanation": "Usada quando o sujeito sofre a ação, ou quando o agente é desconhecido/irrelevante.",
            "rules": [
              "Formação: to be (conjugado) + past participle",
              "Present: The car is repaired.",
              "Past: The car was repaired.",
              "Future: The car will be repaired.",
              "Agente introduzido por 'by': 'The car was fixed by the mechanic.'"
            ]
          },
          "quiz": [
            {
              "question": "Convert to passive: 'The chef cooked the meal.'",
              "options": [
                "The meal cooked by the chef.",
                "The meal was cooked by the chef.",
                "The meal is cooked by the chef.",
                "The chef was cooked the meal."
              ],
              "answer": 1,
              "explanation": "Passado simples passivo: was/were + past participle. 'The meal was cooked by the chef.'"
            }
          ]
        }
      ]
    }
  ],
